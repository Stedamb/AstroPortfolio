---
import CookieConsentBannerScript from '@/components/seo/CookieConsentBannerScript.astro';

const cookieConsent = Astro.cookies.get('cookie-consent')?.value;
const hasConsent = cookieConsent === 'accepted' || cookieConsent === 'rejected';
---

<script is:inline>
  window.__loadGTM = function () {
    if (window._gtmLoaded) return;
    window._gtmLoaded = true;
    window.dataLayer = window.dataLayer || [];
    dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = document.getElementsByTagName('script')[0],
      j = document.createElement('script');
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + 'GTM-MGMXZ5ZC';
    f.parentNode.insertBefore(j, f);
  };
</script>

{cookieConsent === 'accepted' && <script is:inline>window.__loadGTM();</script>}

<style is:global>
  @keyframes cookie-slide-up {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes cookie-slide-down {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(100%);
      opacity: 0;
    }
  }
  .cookie-enter {
    animation: cookie-slide-up 0.4s ease-out;
  }
  .cookie-exit {
    animation: cookie-slide-down 0.4s ease-in forwards;
  }
</style>

{
  !hasConsent && (
    <div
      id="cookie-consent-banner"
      class="fixed right-0 bottom-0 left-0 z-50 hidden border-t border-white/12.5 bg-white/5 backdrop-blur-lg"
    >
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex-1">
          <p class="text-foreground/80 text-sm">
            This site uses cookies to improve your experience.
            <a
              href="/cookie-policy"
              aria-label="Read the cookie policy"
              class="text-muted-foreground hover:text-foreground underline-offset-4 hover:underline"
            >
              Cookie policy
            </a>
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-3">
          <button
            onclick="window.__cookieReject()"
            class="text-foreground/70 hover:text-foreground cursor-pointer rounded-lg border border-white/12.5 bg-white/5 px-4 py-2 text-sm transition-colors hover:bg-white/10"
          >
            Reject All
          </button>
          <button
            onclick="window.__cookieAccept()"
            class="text-foreground/90 hover:text-foreground cursor-pointer rounded-lg border border-white/12.5 bg-linear-to-br from-blue-500/10 to-cyan-500/10 px-4 py-2 text-sm font-semibold shadow-xs transition-colors hover:bg-white/10"
          >
            Accept All
          </button>
        </div>
      </div>
    </div>
  )
}

{!hasConsent && <CookieConsentBannerScript />}
